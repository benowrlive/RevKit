# RevKit environment variables
# Copy this file to .env and fill in your values.

# Database — PostgreSQL connection string.
# For local dev: use a local Postgres instance or a free Neon database.
# For Vercel: set this as an environment variable in the Vercel dashboard.
# Format: postgresql://user:password@host:port/dbname?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/revkit
